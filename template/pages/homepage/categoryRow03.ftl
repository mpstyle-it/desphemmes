<div class="row">


    <div class="col-md-6 col-sm-12 p-0">
            <a class="category-banner-link" href="<@ofbizCatalogAltUrl productCategoryId="W6-025"/>">
                <picture>
                    <!-- mobile -->
                    <source media="(max-width: 768px)" srcset="<@ofbizContentUrl>${assetspath}/images/homepage/mobile/tailoring025_fw26_mob.jpg</@ofbizContentUrl>">

                    <!-- tablet -->
                    <source media="(max-width: 1200px)" srcset="<@ofbizContentUrl>${assetspath}/images/homepage/tailoring025_fw26_desk.jpg</@ofbizContentUrl>">

                    <!-- fallback desktop -->
                    <img src="<@ofbizContentUrl>${assetspath}/images/homepage/tailoring025_fw26_desk.jpg</@ofbizContentUrl>" class="banner-img" alt="Tailoring">
                </picture>
                <div class="banner-caption">
                    <h2 class="banner-title font-sz-large text-uppercase text-white">${SystemLabelMap.Tailoring}</h2>
                </div>
            </a>
        </div>

    <div class="col-md-6 col-sm-12 p-0">
        <a class="category-banner-link" href="<@ofbizCatalogAltUrl productCategoryId="W6-024"/>">
            <picture>
                <!-- mobile -->
                <source media="(max-width: 768px)" srcset="<@ofbizContentUrl>${assetspath}/images/homepage/mobile/knitwear024_fw26_mob.jpg</@ofbizContentUrl>">

                <!-- tablet -->
                <source media="(max-width: 1200px)" srcset="<@ofbizContentUrl>${assetspath}/images/homepage/knitwear024_fw26_desk.jpg</@ofbizContentUrl>">

                <!-- fallback desktop -->
                <img src="<@ofbizContentUrl>${assetspath}/images/homepage/knitwear024_fw26_desk.jpg</@ofbizContentUrl>" class="banner-img" alt="Knitwear">
            </picture>
            <div class="banner-caption">
                <h2 class="banner-title font-sz-large text-uppercase text-white">${SystemLabelMap.Knitwear}</h2>
            </div>
        </a>
    </div>



</div>