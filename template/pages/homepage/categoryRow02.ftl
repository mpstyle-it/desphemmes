<div class="row">

    <div class="col-md-6 col-sm-12 p-0">
            <a class="category-banner-link" href="<@ofbizCatalogAltUrl productCategoryId="W6-022"/>">
                <picture>
                    <!-- mobile -->
                    <source media="(max-width: 768px)" srcset="<@ofbizContentUrl>${assetspath}/images/homepage/mobile/bottoms022_fw26_mob.jpg</@ofbizContentUrl>">

                    <!-- tablet -->
                    <source media="(max-width: 1200px)" srcset="<@ofbizContentUrl>${assetspath}/images/homepage/bottoms022_fw26_desk.jpg</@ofbizContentUrl>">

                    <!-- fallback desktop -->
                    <img src="<@ofbizContentUrl>${assetspath}/images/homepage/bottoms022_fw26_desk.jpg</@ofbizContentUrl>" class="banner-img" alt="Bottoms">
                </picture>
                <div class="banner-caption">
                    <h2 class="banner-title font-sz-large text-uppercase text-white">${SystemLabelMap.Bottoms}</h2>
                </div>
            </a>
        </div>

    <div class="col-md-6 col-sm-12 p-0">
        <a class="category-banner-link" href="<@ofbizCatalogAltUrl productCategoryId="W6-007"/>">
            <picture>
                <!-- mobile -->
                <source media="(max-width: 768px)" srcset="<@ofbizContentUrl>${assetspath}/images/homepage/mobile/top007_fw26_mob.jpg</@ofbizContentUrl>">

                <!-- tablet -->
                <source media="(max-width: 1200px)" srcset="<@ofbizContentUrl>${assetspath}/images/homepage/top007_fw26_desk.jpg</@ofbizContentUrl>">

                <!-- fallback desktop -->
                <img src="<@ofbizContentUrl>${assetspath}/images/homepage/top007_fw26_desk.jpg</@ofbizContentUrl>" class="banner-img" alt="Top">
            </picture>
            <div class="banner-caption">
                <h2 class="banner-title font-sz-large text-uppercase text-white">${SystemLabelMap.Tops}</h2>
            </div>
